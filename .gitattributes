# Normalize line endings: Git stores text files with LF, checks out native.
* text=auto eol=lf

# Explicit text types (kept LF in the repo).
*.cs        text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.sln       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.http      text eol=lf
*.sh        text eol=lf

# Windows-specific scripts should keep CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary files — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.dll       binary
*.exe       binary
*.snk       binary
