{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "Title": "BackendBase API",
    "Version": "v1"
  },
  "Database": {
    "Provider": "InMemory",
